APP_NAME="Kos Tiana Putra"
APP_ENV=local
APP_KEY=
# WAJIB false di production (jangan tampilkan detail error ke pengguna)
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kos_tiana_putra
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Pengaturan khusus Kos Tiana Putra (lihat config/kos.php) ---
KOS_NAME="Kos Tiana Putra 1"

# Rute /demo-login/{role} untuk development. Default: aktif hanya jika APP_ENV=local.
# Di production jangan diisi (atau isi false).
# KOS_DEMO_LOGIN=true

# Informasi pembayaran yang tampil di halaman tagihan penghuni
KOS_BANK_NAME="Bank Central Asia (BCA)"
KOS_BANK_ACCOUNT_NO="7700-8899-21"
KOS_BANK_ACCOUNT_NAME="H. Tiana Sutisna"
KOS_QRIS_NAME="KOS TIANA PUTRA 1"
KOS_WHATSAPP_CS="0812-3456-7890"
KOS_OWNER_NAME="Pak H. Tiana - Pengelola"

# Tanggal jatuh tempo tagihan sewa otomatis (1-28)
KOS_BILL_DUE_DAY=10

# Path/perintah Python untuk prediksi stok (butuh pandas, scikit-learn, pymysql).
# Kosongkan untuk deteksi otomatis, contoh Windows: C:\Python312\python.exe
PYTHON_BIN=
